{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parameters for ptv3",
  "type": "object",
  "definitions": {
    "encoder": {
      "type": "object",
      "properties": {
        "point_cloud_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Range in meters of the pointcloud in meters [min_x, min_y, min_z, max_x, max_y, max_z].",
          "default": [-76.8, -76.8, -3.0, 76.8, 76.8, 5.0],
          "minItems": 6,
          "maxItems": 6
        },
        "voxel_size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Voxels size [x, y, z] in meters.",
          "default": [0.3, 0.3, 8.0],
          "minItems": 3,
          "maxItems": 3
        },
        "max_points_per_voxel": {
          "type": "integer",
          "description": "Padded point slots per voxel; the graph averages the valid slots. Matches the training voxelizer.",
          "default": 32,
          "minimum": 1
        },
        "serialization_orders": {
          "type": "array",
          "items": [
            {
              "const": "z"
            },
            {
              "const": "z-trans"
            }
          ],
          "additionalItems": false,
          "description": "Space-filling curve serialization orders used by the exported model.",
          "default": ["z", "z-trans"],
          "minItems": 2,
          "maxItems": 2
        },
        "pooling_strides": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [2]
          },
          "description": "Serialized pooling stride for each encoder downsampling stage.",
          "default": [2, 2, 2, 2],
          "minItems": 1
        },
        "enc_channels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Encoder feature channels per stage, finest to deepest (pooling_strides size + 1 entries).",
          "default": [32, 64, 128, 256, 512],
          "minItems": 2
        },
        "patch_sizes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Attention window per encoder stage, finest to deepest (pooling_strides size + 1 entries). Sizes the padded patch_order inputs.",
          "default": [512, 512, 512, 512, 512],
          "minItems": 2
        }
      },
      "required": [
        "point_cloud_range",
        "voxel_size",
        "max_points_per_voxel",
        "serialization_orders",
        "pooling_strides",
        "enc_channels",
        "patch_sizes"
      ],
      "additionalProperties": false
    },
    "segmentation3d": {
      "type": "object",
      "properties": {
        "class_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Segmentation class names.",
          "minItems": 1,
          "uniqueItems": true
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "description": "Flat RGB palette for visualization output. Must contain 3 values per class."
        },
        "dec_depths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Decoder attention-block counts per stage; stages with blocks add serialization-metadata inputs to the seg-head engine.",
          "default": [0, 0, 0, 0],
          "minItems": 1
        }
      },
      "required": ["class_names", "palette", "dec_depths"],
      "additionalProperties": false
    },
    "detection3d": {
      "type": "object",
      "properties": {
        "class_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Detection class names in the model's output label order."
        },
        "num_anchor": {
          "type": "integer",
          "minimum": 1,
          "description": "Instances the detection head decodes per frame, one box per instance."
        },
        "num_temp_instances": {
          "type": "integer",
          "minimum": 1,
          "description": "Instances the detection head carries to the next frame, they lead the instances of a frame. Smaller than num_anchor."
        },
        "embed_dims": {
          "type": "integer",
          "minimum": 1,
          "description": "Feature width of a carried instance."
        },
        "default_time_interval": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Frame gap in seconds fed to the detection head when a stream starts."
        },
        "max_time_interval": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Largest frame gap in seconds that keeps the carried instances, a larger gap starts a new stream."
        },
        "track_birth_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Score from which an instance without a track starts a new one."
        },
        "circle_nms": {
          "type": "object",
          "description": "Circle NMS across the classes of every group, by center distance in the BEV plane.",
          "properties": {
            "class_groups": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -1
              },
              "description": "Group of every class in class_names order, -1 for a class never suppressed."
            },
            "radii": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": "Suppression radius in meters of every group."
            }
          },
          "required": ["class_groups", "radii"],
          "additionalProperties": false
        }
      },
      "required": [
        "class_names",
        "num_anchor",
        "num_temp_instances",
        "embed_dims",
        "default_time_interval",
        "max_time_interval",
        "track_birth_score",
        "circle_nms"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "/**": {
      "type": "object",
      "properties": {
        "ros__parameters": {
          "type": "object",
          "properties": {
            "encoder": {
              "$ref": "#/definitions/encoder"
            },
            "segmentation3d": {
              "$ref": "#/definitions/segmentation3d"
            },
            "detection3d": {
              "$ref": "#/definitions/detection3d"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["ros__parameters"],
      "additionalProperties": false
    }
  },
  "required": ["/**"],
  "additionalProperties": false
}
